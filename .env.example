# 이 파일은 "어떤 비밀 값이 필요한지" 이름만 적어 둔 견본입니다.
# 실제 값은 .env 파일에 직접 적으세요. (.env 는 깃허브에 올라가지 않습니다.)
# 이 파일에는 절대 실제 값을 적지 마세요.

# 이미 사용 중
OPENAI_API_KEY=
# AI 모델 이름(선택). 비우면 gpt-4o-mini
OPENAI_MODEL=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=
GITHUB_TOKEN=

# 작업 3번: 접속 비밀번호
ACCESS_PASSWORD=
SESSION_SECRET=

# 작업 4번: 데이터 보관함 (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# 작업 13번: 요약 메일 발송
RESEND_API_KEY=
REPORT_EMAIL=
# 보내는 사람 주소(선택). 비우면 Resend 시험용 주소(onboarding@resend.dev)를 쓰며, 이 경우 Resend 계정 소유자 주소로만 보낼 수 있다.
MAIL_FROM=

# 작업 14번: 자동 실행 주소 보호
CRON_SECRET=
