# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 이름만 적은 견본 파일은 올려도 된다 (실제 값은 절대 넣지 않는다)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 삭제 대기 폴더 (사용자가 직접 확인 후 삭제)
/trash-can/

# 아침 요약 미리보기 결과
/digest-preview.html

# 작업 기록 폴더(명령 이력 등)는 커밋하지 않는다. 미리보기 설정만 예외
/.bkit/
/.claude/*
!/.claude/launch.json
